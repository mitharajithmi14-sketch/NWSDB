{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "auth": { "ClusterId": "account", "RateLimiterPolicy": "fixed", "Match": { "Path": "/api/auth/{**catch-all}" } },
      "accounts": { "ClusterId": "account", "RateLimiterPolicy": "fixed", "Match": { "Path": "/api/accounts/{**catch-all}" } },
      "bills": { "ClusterId": "billing", "RateLimiterPolicy": "fixed", "Match": { "Path": "/api/bills/{**catch-all}" } },
      "usage": { "ClusterId": "usage", "RateLimiterPolicy": "fixed", "Match": { "Path": "/api/usage/{**catch-all}" } },
      "payments": { "ClusterId": "payment", "RateLimiterPolicy": "fixed", "Match": { "Path": "/api/payments/{**catch-all}" } },
      "notifications": { "ClusterId": "notification", "RateLimiterPolicy": "fixed", "Match": { "Path": "/api/notifications/{**catch-all}" } },
      "contact": { "ClusterId": "notification", "RateLimiterPolicy": "fixed", "Match": { "Path": "/api/contact/{**catch-all}" } }
    },
    "Clusters": {
      "account": { "Destinations": { "d1": { "Address": "http://localhost:5001/" } } },
      "billing": { "Destinations": { "d1": { "Address": "http://localhost:5002/" } } },
      "usage": { "Destinations": { "d1": { "Address": "http://localhost:5003/" } } },
      "payment": { "Destinations": { "d1": { "Address": "http://localhost:5004/" } } },
      "notification": { "Destinations": { "d1": { "Address": "http://localhost:5005/" } } }
    }
  }
}
